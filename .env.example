# ============================================================
# 复制这个文件为 .env，然后填入你自己的值
#   Copy-Item .env.example .env
#
# .env 已被 .gitignore 忽略，永远不会被提交。
# ============================================================

# ---------- 密钥 ----------
# 方式 1（推荐）：直接写在这里
# 方式 2：设成系统环境变量 -> setx DEEPSEEK_API_KEY "sk-你的key"
# 方式 3：写在别的文件里（比如 D:\secrets\deepseek.key），
#         然后只在这里填 DEEPSEEK_API_KEY_FILE=D:\secrets\deepseek.key
#         适合以后搬到 N100 上跑，比环境变量少一个泄露面
#
# 优先级：环境变量 > _FILE 指向的文件 > 本文件
DEEPSEEK_API_KEY=sk-在这里填你的key
# DEEPSEEK_API_KEY_FILE=

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR，排查问题时开 DEBUG
XIAOYU_LOG_LEVEL=INFO

# ---------- 音频设备 ----------
# 【重要】留空 = 用系统默认设备。但系统默认输出**不一定是喇叭** ——
# 如果默认输出是显示器的 HDMI 音频，你会完全听不到声音，而且日志看起来正常。
# 所以第一次一定要跑这个，挨个试哪个设备真的会响：
#     python scripts\diagnose_audio.py
# 再用 python scripts\check_audio.py 列出全部编号。
XIAOYU_MIC_DEVICE=
XIAOYU_SPK_DEVICE=
# 静音判定阈值，麦克风太灵敏（老是"说完了"）就调高
XIAOYU_SILENCE_THRESHOLD=0.015