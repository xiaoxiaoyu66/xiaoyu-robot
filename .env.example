# ============================================================
# 复制这个文件为 .env，然后填入你自己的值
#   Copy-Item .env.example .env
#
# .env 已被 .gitignore 忽略，永远不会被提交。
# ============================================================

# ---------- 密钥 ----------
# 方式 1（推荐）：直接写在这里
# 方式 2：设成系统环境变量 -> setx DEEPSEEK_API_KEY "sk-你的key"
# 方式 3：写在别的文件里（比如 D:\secrets\deepseek.key），
#         然后只在这里填 DEEPSEEK_API_KEY_FILE=D:\secrets\deepseek.key
#         适合以后搬到 N100 上跑，比环境变量少一个泄露面
#
# 优先级：环境变量 > _FILE 指向的文件 > 本文件
DEEPSEEK_API_KEY=sk-在这里填你的key
# DEEPSEEK_API_KEY_FILE=

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR，排查问题时开 DEBUG
XIAOYU_LOG_LEVEL=INFO

# ---------- 音频设备 ----------
# 【重要】按名字选，不要写死编号。
#
# 两个坑，都是实测踩出来的：
#   1. 系统默认输出**不一定是喇叭**。如果默认输出是显示器的 HDMI 音频，
#      你会完全听不到声音，而日志看起来一切正常。
#   2. 设备**编号会漂移**。同一台机器上，两次运行之间 [3] 和 [4] 互换过。
#      所以写死 XIAOYU_SPK_DEVICE=4 会时好时坏。
#
# 名字填"能唯一认出来的一段就行"，大小写和空格无所谓。
# 第一次一定要先跑这两个：
#     python scripts\check_audio.py        # 列出所有设备的名字
#     python scripts\diagnose_audio.py     # 挨个试，哪个真的会出声
XIAOYU_SPK_DEVICE_NAME=
XIAOYU_MIC_DEVICE_NAME=

# 号码只是备用手段：上面名字找不到时才用。平时留空。
XIAOYU_SPK_DEVICE=
XIAOYU_MIC_DEVICE=

# ---------- 静音判定 ----------
# 音量低于这个值算静音，麦克风太灵敏就调高
XIAOYU_SILENCE_THRESHOLD=0.015

# 连续安静多久算你说完了。调小 = 反应快，但容易把说话中间的停顿当成说完
XIAOYU_SILENCE_SECONDS=0.5

# ---------- 提示音 ----------
# 唤醒命中后立刻播一声短音（"听到了"），填补它思考时的沉默。嫌吵就设 0
XIAOYU_CUE_ENABLED=1
# ---------- 语音合成 ----------
# local = 用本地模型（快，推荐）；edge = 微软云端（好听，但每句话都要联网握手，
#         实测首块音频要 0.88~11.76 秒，反应慢的元凶就是它）
XIAOYU_TTS_ENGINE=local

# 本地模型目录名（models/tts/ 下有哪些就填哪个）
#   vits-piper-zh_CN-huayan-medium  最快，音色一般
#   matcha-icefall-zh-baker         质量更好，需要声码器
# 两个都已经下好了。想挑音色先听这两个（同一句话）：
#   data\voice_1_huayan.wav（当前默认） / data\voice_2_baker.wav
XIAOYU_TTS_MODEL=vits-piper-zh_CN-huayan-medium

# 只有 matcha 系模型要填（文件名，相对于 models/tts/）
# XIAOYU_TTS_VOCODER=vocos-22khz-univ.onnx

# 语速：1.0 原速，1.1 稍快，0.9 稍慢
XIAOYU_TTS_SPEED=1.0

# 合成线程数。实测 2 线程和 4 线程差别很小，够用就行
XIAOYU_TTS_THREADS=2

# 只有 edge 引擎用的音色
# XIAOYU_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 表情脸（S5）----------
# 主控起一个 WebSocket 服务，浏览器打开 face/index.html?token=xiaoyu 就是脸。
# 同一 WiFi 的手机/平板把 localhost 换成电脑的 IP 即可（脸只是个网页）。
# 嫌脸烦就设 XIAOYU_FACE_ENABLED=0，语音功能不受影响。
XIAOYU_FACE_ENABLED=1
XIAOYU_FACE_PORT=8765
# 连接要带这个 token，防局域网里别的设备误连。不用公网映射。
XIAOYU_FACE_TOKEN=xiaoyu
# 控制台表情脸：终端里也会打出字符画状态/口型（调试用，嫌吵设 0）
XIAOYU_FACE_CONSOLE=1
