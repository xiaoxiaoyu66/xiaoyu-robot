# ================= Python =================
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/

# ================= 虚拟环境 =================
.venv/
venv/
env/

# ================= 密钥（绝对不要提交）=================
.env
.env.local
*.key

# ================= 模型（体积大，不进 git）=================
models/*
!models/.gitkeep

# ================= 数据 / 日志 / 音频产物 =================
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

*.db
*.sqlite3
*.log
*.mp3
*.wav
*.pcm

# ================= 临时脚本草稿区 =================
# 所有一次性的探针 / 压测 / 试验脚本都放这里，不要散落到系统临时目录
.scratch/

# ================= 编辑器 / 系统 =================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
# 豆包生成的概念图原始大图（46MB），只留 docs/design/ 下的压缩版
docs/assert/
